              <i class='bx bxl-github' ></i>
            </a><%
          }

          if (subRoot.note.hasLabel("RSSLink") &&
                subRoot.note.getLabelValue("RSSLink") != null) { %>
            <a class="platformStyle" target="_blank" rel="noopener" title="RSS" href="<%= subRoot.note.getLabelValue("RSSLink") %>">
              <i class='bx bx-rss' ></i>
            </a><%
          }

          if (subRoot.note.hasLabel("linkedinLink") &&
                subRoot.note.getLabelValue("linkedinLink") != null) { %>
            <a class="platformStyle" target="_blank" rel="noopener" title="LinkedIn" href="<%= subRoot.note.getLabelValue("linkedinLink") %>">
              <i class='bx bxl-linkedin' ></i>
            </a><%
          }

          if (subRoot.note.hasLabel("mailLink") &&
                subRoot.note.getLabelValue("mailLink") != null) { %>
            <a class="platformStyle" target="_blank" rel="noopener" title="EMail" href="mailto:<%= subRoot.note.getLabelValue("mailLink") %>">
              <i class='bx bx-at'></i>
            </a><%
          }

          if (subRoot.note.hasLabel("bmcLink") &&
                subRoot.note.getLabelValue("bmcLink") != null) { %>
            <a class="platformStyle" target="_blank" rel="noopener" title="Buy Me a Coffee" href="<%= subRoot.note.getLabelValue("bmcLink") %>">
              <i class='bx bxs-coffee' ></i>
            </a><%
          } %>
        </div><%
      } %>

      <div id="announcement" class="bloggerInfoCardStyle">
